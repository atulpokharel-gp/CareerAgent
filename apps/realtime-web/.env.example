# ─────────────────────────────────────────────────────────────────────────────
# career-ops realtime-web — Environment Variables
# Copy this file to .env (for local dev) or add as Vercel Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# ── CORS ───────────────────────────────────────────────────────────────────
# For Vercel: set to your deployment URL, e.g. https://your-app.vercel.app
# For local dev: * allows all origins
CORS_ORIGIN=*

# ── LLM Provider API keys ──────────────────────────────────────────────────
# At least one is required for CV analysis and job evaluation features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Session Store ──────────────────────────────────────────────────────────
# "memory" = in-process Map (default; fine for single-instance deploys)
# Set to an Upstash Redis URL for cross-instance session sharing on Vercel:
#   redis://default:<password>@<host>.upstash.io:6379
REDIS_URL=memory
REDIS_KEY_PREFIX=career-ops:realtime

SESSION_TTL_MS=21600000   # 6 hours
MAX_SESSIONS=5000

# ── Scanning ────────────────────────────────────────────────────────────────
# Max concurrent portal scans (local dev only — disabled on Vercel)
GLOBAL_CONCURRENT_SCANS=20

# ── Client (build-time) ────────────────────────────────────────────────────
# Set VITE_API_BASE="" for Vercel (same-origin relative URLs).
# Leave unset or set to "http://localhost:8787" for local dev without the proxy.
VITE_API_BASE=
